{
  "schema_version": 1,
  "backend": "transformers",
  "device": "cpu",
  "gpu_memory_gib": 8,
  "load_in_8bit": false,
  "model": "deepseek-ai/DeepSeek-Prover-V2-7B",
  "prompt_mode": "auto",
  "template": "AI_Proof_Demo/PartialProof.lean.template",
  "context": [
    "AI_Proof_Demo/FiniteDiffProofReference.txt"
  ],
  "completion": "AI_Proof_Demo/completion.txt",
  "output": "AI_Proof_Demo/AIProofGenerated.lean",
  "instruction": [],
  "forbid_identifier": [],
  "attempts": 3,
  "temperature": 0.0,
  "num_predict": 512,
  "prefill_num_predict": 96,
  "transformers_cache": ".cache/huggingface",
  "offline": true,
  "timeout": 300,
  "minimize_mode": "lint",
  "verify_only": false,
  "log_dir": "AI_Proof_Demo/runs",
  "no_log": false
}
